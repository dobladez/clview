;;; reference.el --- what Org itself makes of each file, for ADR-0040  -*- lexical-binding: t -*-
;; emacs -Q --batch -l reference.el FILE...
;; Prints a line a file: its path, then KIND=COUNT, KIND as measure's `count` names them, from
;; org-element-parse-buffer in a buffer in org-mode (so the file's own #+TODO lines count).
(require 'org)
(require 'org-element)
(require 'cl-lib)
(defun measure-count (tree type &optional pred)
  (length (org-element-map tree type (lambda (e) (when (or (null pred) (funcall pred e)) t)))))
(dolist (file command-line-args-left)
  (with-temp-buffer
    (insert-file-contents file)
    ;; No #+SETUPFILE is read, as clv reads none.
    (cl-letf (((symbol-function 'org-file-contents) (lambda (&rest _) "")))
      (let ((org-inhibit-startup t)) (delay-mode-hooks (org-mode))))
    (let* ((tree (org-element-parse-buffer))
           (counts
            (list
             (cons "headline" (measure-count tree 'headline))
             (cons "todo" (measure-count tree 'headline (lambda (h) (org-element-property :todo-keyword h))))
             (cons "priority" (measure-count tree 'headline (lambda (h) (org-element-property :priority h))))
             (cons "tags" (measure-count tree 'headline (lambda (h) (org-element-property :tags h))))
             (cons "planning" (measure-count tree 'planning))
             (cons "property-drawer" (measure-count tree 'property-drawer))
             (cons "drawer" (measure-count tree 'drawer))
             (cons "bracket-link" (measure-count tree 'link (lambda (l) (eq (org-element-property :format l) 'bracket))))
             (cons "plain-link" (measure-count tree 'link (lambda (l) (memq (org-element-property :format l) '(plain angle)))))
             (cons "footnote-reference" (measure-count tree 'footnote-reference))
             (cons "footnote-definition" (measure-count tree 'footnote-definition))
             (cons "src-block" (measure-count tree 'src-block))
             (cons "example-block" (measure-count tree 'example-block))
             (cons "quote-block" (measure-count tree 'quote-block))
             (cons "verse-block" (measure-count tree 'verse-block))
             (cons "center-block" (measure-count tree 'center-block))
             (cons "special-block" (measure-count tree 'special-block))
             (cons "export-block" (measure-count tree 'export-block))
             (cons "comment-block" (measure-count tree 'comment-block))
             (cons "table" (measure-count tree 'table (lambda (e) (eq (org-element-property :type e) 'org))))
             (cons "table-row" (measure-count tree 'table-row (lambda (r) (eq (org-element-property :type (org-element-property :parent r)) 'org))))
             (cons "plain-list" (measure-count tree 'plain-list))
             (cons "item" (measure-count tree 'item))
             (cons "checkbox" (measure-count tree 'item (lambda (i) (org-element-property :checkbox i))))
             (cons "target" (measure-count tree 'target))
             (cons "keyword" (measure-count tree 'keyword))
             (cons "fixed-width" (measure-count tree 'fixed-width))
             (cons "timestamp" (measure-count tree 'timestamp))
             (cons "bold" (measure-count tree 'bold))
             (cons "italic" (measure-count tree 'italic))
             (cons "underline" (measure-count tree 'underline))
             (cons "strike-through" (measure-count tree 'strike-through))
             (cons "verbatim" (measure-count tree 'verbatim))
             (cons "code" (measure-count tree 'code)))))
      (princ file)
      (dolist (c counts) (princ (format "\t%s=%d" (car c) (cdr c))))
      (princ "\n"))))
